{
    "doc": "https://github.com/thingsdb/module-go-mysqlendpoint#readme",
    "version": "0.2.0",
    "main": {
        "linux/amd64": "bin/mysqlendpoint_linux_amd64.bin",
        "linux/arm64": "bin/mysqlendpoint_linux_arm64.bin",
        "darwin/amd64": "bin/mysqlendpoint_darwin_amd64.bin"
    },
    "defaults": {
        "load": false,
        "deep": 0
    },
    "exposes": {
        "_call": {
            "doc": "Use with either 'info' or 'reload' as argument.",
            "argmap": ["method"]
        },
        "info": "|this| this._call('info')",
        "reload": "|this| this._call('reload')"
    }
}