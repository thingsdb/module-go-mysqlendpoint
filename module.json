{
    "doc": "https://github.com/thingsdb/module-go-mysqlendpoint#readme",
    "version": "0.1.0",
    "main": {
        "linux/386": "bin/mysqlendpoint_linux_386.bin",
        "linux/amd64": "bin/mysqlendpoint_linux_amd64.bin",
        "linux/arm": "bin/mysqlendpoint_linux_arm.bin",
        "linux/arm64": "bin/mysqlendpoint_linux_arm64.bin",
        "freebsd/386": "bin/mysqlendpoint_freebsd_386.bin",
        "freebsd/amd64": "bin/mysqlendpoint_freebsd_amd64.bin",
        "freebsd/arm": "bin/mysqlendpoint_freebsd_arm.bin",
        "freebsd/arm64": "bin/mysqlendpoint_freebsd_arm64.bin",
        "darwin/amd64": "bin/mysqlendpoint_darwin_amd64.bin"
    },
    "defaults": {
        "load": false,
        "deep": 0
    },
    "exposes": {
        "_call": {
            "doc": "Returns mysql server status and schema",
            "argmap": ["method"]
        },
        "info": "|this| this._call('info')"
    }
}